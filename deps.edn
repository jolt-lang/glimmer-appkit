{;; jolt.ffi/write takes the value BEFORE the offset as of jolt 0.8.0, and the
 ;; two spellings are both integers — an older runtime writes to the wrong
 ;; place rather than failing. Declare the floor so it refuses instead.
 :jolt/min-version "0.8.0"

 :paths ["src"]

 ;; glimmer-appkit is the native macOS (AppKit) backend for glimmer: glimmer owns
 ;; the reactive core (ratom, component model, reconciler) and knows nothing
 ;; about any toolkit; this project supplies the widgets, the prop/event wiring
 ;; and the app loop, and registers them through glimmer.backend.
 ;;
 ;; AppKit itself is NOT declared under :jolt/native — glimmer-appkit.ffi loads
 ;; the frameworks itself, guarded to macOS only. That keeps `jolt -M:test`
 ;; (the headless markup/string tests) runnable on Linux CI, where no AppKit
 ;; exists; on macOS the dlopen happens at require time, before any class is
 ;; looked up.
 ;;
 ;; hiccup is used to serialize Pango markup data ([:span {...} "text"]) for a
 ;; label's :markup prop.
 :deps {jolt-lang/glimmer {:git/url "https://github.com/jolt-lang/glimmer"
                           :git/tag "v0.1.3"
                           :git/sha "93758e82548daf75e357274558fc3e81bb754c9a"}
        weavejester/hiccup
        {:git/url "https://github.com/weavejester/hiccup"
         :git/sha "b6b12097ba973141fe87c1b4d6a27ddcce5d5929"}}

 ;; Each runnable has its own alias with :main-opts (jolt's -M:alias form needs
 ;; main-opts). Tasks are thin wrappers so you can run `jolt counter`, etc.
 :aliases {:test    {:extra-paths ["test"]     :main-opts ["-m" "glimmer-appkit.test-runner"]}
           :counter {:extra-paths ["examples"] :main-opts ["-m" "glimmer-appkit.counter"]}
           :todo    {:extra-paths ["examples"] :main-opts ["-m" "glimmer-appkit.todo"]}
           :smoke   {:extra-paths ["examples"] :main-opts ["-m" "glimmer-appkit.reactivity-smoke"]}
           :main-thread-smoke {:extra-paths ["examples"] :main-opts ["-m" "glimmer-appkit.main-thread-smoke"]}
           :repl-live-smoke {:extra-paths ["examples"] :main-opts ["-m" "glimmer-appkit.repl-live-smoke"]}
           :keyed   {:extra-paths ["examples"] :main-opts ["-m" "glimmer-appkit.keyed"]}}

 :tasks {test    "jolt -M:test"
         counter "jolt -M:counter"
         todo    "jolt -M:todo"
         smoke   "jolt -M:smoke"
         main-thread-smoke "jolt -M:main-thread-smoke"
         repl-live-smoke "jolt -M:repl-live-smoke"
         keyed   "jolt -M:keyed"}}
